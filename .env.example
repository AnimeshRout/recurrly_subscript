EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Domain restriction for login access.
# Set to a specific domain to restrict access (e.g., hbplus.fit)
# Set to * to allow all domains (for testing/development)
#
# Examples:
#   EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit   → Only @hbplus.fit emails can login
#   EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=gmail.com    → Only @gmail.com emails can login
#   EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=*            → All email domains allowed
#
# For HB+ assignment: set to hbplus.fit to demonstrate domain restriction
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit
